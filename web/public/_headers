# Cloudflare Pages 캐시 정책
# 해시 파일명(불변) 에셋 — 1년 영구 캐시
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 포스터·정적 이미지 — 1년 영구 캐시
/posters/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 진입점 — 항상 재검증(새 배포 즉시 반영)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
